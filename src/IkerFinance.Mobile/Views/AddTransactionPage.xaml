<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:IkerFinance.Mobile.ViewModels"
             x:Class="IkerFinance.Mobile.Views.AddTransactionPage"
             x:DataType="viewModels:AddTransactionViewModel"
             Title="Add Transaction"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Transaction Type Picker -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Type"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Picker SelectedItem="{Binding TransactionType}"
                        BackgroundColor="#f9fafb"
                        TextColor="#1f2937">
                    <Picker.Items>
                        <x:String>Expense</x:String>
                        <x:String>Income</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <!-- Description -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Description *"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Entry Text="{Binding Description}"
                       Placeholder="Enter description"
                       BackgroundColor="#f9fafb"
                       TextColor="#1f2937"
                       PlaceholderColor="#9ca3af" />
            </VerticalStackLayout>

            <!-- Amount -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Amount *"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Entry Text="{Binding Amount}"
                       Placeholder="0.00"
                       Keyboard="Numeric"
                       BackgroundColor="#f9fafb"
                       TextColor="#1f2937"
                       PlaceholderColor="#9ca3af" />
            </VerticalStackLayout>

            <!-- Currency -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Currency"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Picker SelectedItem="{Binding CurrencyCode}"
                        BackgroundColor="#f9fafb"
                        TextColor="#1f2937">
                    <Picker.Items>
                        <x:String>USD</x:String>
                        <x:String>EUR</x:String>
                        <x:String>GBP</x:String>
                        <x:String>SEK</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <!-- Category -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Category *"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Picker SelectedItem="{Binding CategoryName}"
                        BackgroundColor="#f9fafb"
                        TextColor="#1f2937">
                    <Picker.Items>
                        <x:String>Food</x:String>
                        <x:String>Transportation</x:String>
                        <x:String>Entertainment</x:String>
                        <x:String>Utilities</x:String>
                        <x:String>Shopping</x:String>
                        <x:String>Healthcare</x:String>
                        <x:String>Salary</x:String>
                        <x:String>Investment</x:String>
                        <x:String>Other</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <!-- Date -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Date"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <DatePicker Date="{Binding Date}"
                            BackgroundColor="#f9fafb"
                            TextColor="#1f2937" />
            </VerticalStackLayout>

            <!-- Notes -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Notes"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#374151" />
                <Editor Text="{Binding Notes}"
                        Placeholder="Add notes (optional)"
                        HeightRequest="100"
                        BackgroundColor="#f9fafb"
                        TextColor="#1f2937"
                        PlaceholderColor="#9ca3af" />
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <HorizontalStackLayout Spacing="12" Margin="0,20,0,0">
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#f3f4f6"
                        TextColor="#374151"
                        CornerRadius="8"
                        Padding="15"
                        FontAttributes="Bold"
                        HorizontalOptions="FillAndExpand" />

                <Button Text="Save"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#3b82f6"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="15"
                        FontAttributes="Bold"
                        HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#3b82f6"
                               Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
