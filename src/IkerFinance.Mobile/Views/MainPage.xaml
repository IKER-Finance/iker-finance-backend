<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:IkerFinance.Mobile.ViewModels"
             x:Class="IkerFinance.Mobile.Views.MainPage"
             x:DataType="viewModels:MainViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout"
                     Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Welcome to IkerFinance!"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Your personal finance manager"
                   FontSize="16"
                   HorizontalOptions="Center"
                   Opacity="0.7" />

            <VerticalStackLayout Spacing="15" Margin="0,30,0,0">
                <Frame BorderColor="{StaticResource Primary}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Transactions"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="Track your income and expenses"
                               Opacity="0.7" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Primary}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Budgets"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="Manage your monthly budgets"
                               Opacity="0.7" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Primary}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Categories"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="Organize your spending"
                               Opacity="0.7" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="{StaticResource Primary}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Profile"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="Manage your account settings"
                               Opacity="0.7" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
