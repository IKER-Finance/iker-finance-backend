<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:IkerFinance.Mobile.ViewModels"
             x:Class="IkerFinance.Mobile.Views.RegisterPage"
             x:DataType="viewModels:RegisterViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="10" Margin="0,20,0,30">
                <Label Text="Create Account"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Join IkerFinance to manage your finances"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Opacity="0.7" />
            </VerticalStackLayout>

            <!-- Registration Form -->
            <VerticalStackLayout Spacing="15">
                <Label Text="First Name" FontSize="14" />
                <Entry Text="{Binding FirstName}"
                       Placeholder="Enter your first name"
                       ReturnType="Next" />

                <Label Text="Last Name" FontSize="14" Margin="0,10,0,0" />
                <Entry Text="{Binding LastName}"
                       Placeholder="Enter your last name"
                       ReturnType="Next" />

                <Label Text="Email" FontSize="14" Margin="0,10,0,0" />
                <Entry Text="{Binding Email}"
                       Placeholder="Enter your email"
                       Keyboard="Email"
                       ReturnType="Next" />

                <Label Text="Password" FontSize="14" Margin="0,10,0,0" />
                <Entry Text="{Binding Password}"
                       Placeholder="Enter your password (min 6 characters)"
                       IsPassword="True"
                       ReturnType="Next" />

                <Label Text="Confirm Password" FontSize="14" Margin="0,10,0,0" />
                <Entry Text="{Binding ConfirmPassword}"
                       Placeholder="Confirm your password"
                       IsPassword="True"
                       ReturnType="Next" />

                <Label Text="Home Currency" FontSize="14" Margin="0,10,0,0" />
                <Picker Title="Select your currency"
                        ItemsSource="{Binding AvailableCurrencies}"
                        SelectedItem="{Binding SelectedCurrency}" />
            </VerticalStackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="Red"
                   FontSize="14"
                   HorizontalOptions="Center" />

            <!-- Register Button -->
            <Button Text="Register"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,10,0,0"
                    HeightRequest="50" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              Color="{StaticResource Primary}" />

            <!-- Login Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                <Label Text="Already have an account?"
                       VerticalOptions="Center" />
                <Label Text="Login"
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
