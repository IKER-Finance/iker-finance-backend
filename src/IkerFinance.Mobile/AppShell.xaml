<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IkerFinance.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:IkerFinance.Mobile"
    xmlns:views="clr-namespace:IkerFinance.Mobile.Views"
    Title="IkerFinance"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="True">

    <Shell.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#3b82f6</Color>
            <Color x:Key="PrimaryDark">#2563eb</Color>
            <Color x:Key="Gray200">#e5e7eb</Color>
            <Color x:Key="Gray600">#475569</Color>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Tab Bar Styling -->
    <Shell.TabBarBackgroundColor>White</Shell.TabBarBackgroundColor>
    <Shell.TabBarTitleColor>#475569</Shell.TabBarTitleColor>
    <Shell.TabBarUnselectedColor>#9ca3af</Shell.TabBarUnselectedColor>
    <Shell.TabBarForegroundColor>#3b82f6</Shell.TabBarForegroundColor>

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <TabBar Route="MainTabs">
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />

        <ShellContent
            Title="Transactions"
            ContentTemplate="{DataTemplate views:TransactionsPage}"
            Route="TransactionsPage" />

        <ShellContent
            Title="Budgets"
            ContentTemplate="{DataTemplate views:BudgetsPage}"
            Route="BudgetsPage" />

        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate views:ProfilePage}"
            Route="ProfilePage" />
    </TabBar>

</Shell>
